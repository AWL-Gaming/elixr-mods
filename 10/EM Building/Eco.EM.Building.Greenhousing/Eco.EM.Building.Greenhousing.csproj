<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	
	<RootNamespace>Eco.EM.Building.Greenhousing</RootNamespace>
	<Company>Elixr Solutions</Company>
	<Authors>Elixr Mods</Authors>
	<Product>EM Greenhousing</Product>
	<Version>3.5.1</Version>
	<Copyright>Elixr Solutions 2020</Copyright>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageProjectUrl>https://elixrmods.com/</PackageProjectUrl>
	<PackageIcon></PackageIcon>
	<RepositoryUrl>https://git.elixr-solutions.com/elixrmods/elixr-mods</RepositoryUrl>
	<RepositoryType>Private GitLab</RepositoryType>
	<NeutralLanguage>en</NeutralLanguage>
	<AssemblyName>Eco.EM.Building.Greenhousing</AssemblyName>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<PackageId>ElixrMods.Building.Greenhousing</PackageId>
	<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	<OutputPath>..\..\..\bin\11.0\EM Building</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <ElixrCleanOutput>true</ElixrCleanOutput>
    <ElixrStripArtistry>true</ElixrStripArtistry>
  </PropertyGroup>
  <Import Project="..\..\..\build\ElixrOutput.targets" />

  <ItemGroup>
	<None Remove="Ecopedia\Documentation;Building.xml" />
	<None Remove="Ecopedia\Documentation;Greenhousing.xml" />
  </ItemGroup>

  <ItemGroup>
	<EmbeddedResource Include="Ecopedia\ModDocumentation%3bEM Building.xml" />
	<EmbeddedResource Include="Ecopedia\ModDocumentation%3bEM Building%3bGreenhousing.xml" />
  </ItemGroup>
	<ItemGroup>
		
		<PackageReference Include="NetFabric.Hyperlinq" Version="3.0.0-beta48" />
	</ItemGroup>
</Project>
