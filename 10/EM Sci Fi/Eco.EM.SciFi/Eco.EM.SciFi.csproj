<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    
    <RootNamespace>Eco.EM.SciFi</RootNamespace>
    <Version>3.4.0</Version>
    <Authors>Elixr Mods</Authors>
    <Company>Elixr Solutions</Company>
    <Product>EM SciFi</Product>
    <Copyright>Elixr Solutions 2020</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://elixrmods.com/</PackageProjectUrl>
    <PackageIcon></PackageIcon>
    <RepositoryUrl>https://git.elixr-solutions.com/elixrmods/elixr-mods</RepositoryUrl>
    <RepositoryType>Private GitLab</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyName>Eco.EM.SciFi</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>ElixrMods.SciFi</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\..\bin\10.0\EM SciFi</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <ElixrCleanOutput>true</ElixrCleanOutput>
    <ElixrStripArtistry>true</ElixrStripArtistry>
  </PropertyGroup>
  <Import Project="..\..\..\build\ElixrOutput.targets" />

  <ItemGroup>
    <Compile Remove="MicroTownHub.cs" />
    <Compile Remove="MTSmallHouse.cs" />
    <Compile Remove="MTWheatFarm.cs" />
    <Compile Remove="Objects\BlackHoleUnit.cs" />
    <Compile Remove="Objects\MicroTownHub.cs" />
    <Compile Remove="Objects\MTSmallHouse.cs" />
    <Compile Remove="Objects\MTWheatFarm.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Items\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Objects\BlackHoleUnit.cs" />
    <None Include="Objects\MicroTownHub.cs" />
    <None Include="Objects\MTSmallHouse.cs" />
    <None Include="Objects\MTWheatFarm.cs" />
  </ItemGroup>

</Project>
