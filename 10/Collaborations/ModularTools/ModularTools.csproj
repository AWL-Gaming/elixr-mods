	<Import Project="..\..\..\build\ElixrOutput.targets" />

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_ModularPackage>$(ElixrRepositoryRoot)bin\ModularTools\Mods\UserCode\</_ModularPackage>
    </PropertyGroup>
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\AutoGen') or !Exists('$(MSBuildProjectDirectory)\ModularTools') or !Exists('$(MSBuildProjectDirectory)\Tools')"
           Text="ModularTools packaging requires the current project's three source directories." />
    <ElixrValidatePaths Paths="$(MSBuildProjectDirectory)\AutoGen;$(MSBuildProjectDirectory)\ModularTools;$(MSBuildProjectDirectory)\Tools" AllowedRoots="$(MSBuildProjectDirectory)" />
    <ElixrValidatePaths Paths="$(_ModularPackage)" AllowedRoots="$(ElixrRepositoryRoot)bin" />
    <ItemGroup>
      <_ModularAutoGen Include="$(MSBuildProjectDirectory)\AutoGen\**\*" />
      <_ModularSource Include="$(MSBuildProjectDirectory)\ModularTools\**\*" />
      <_ModularTools Include="$(MSBuildProjectDirectory)\Tools\**\*" />
    </ItemGroup>
    <Error Condition="'@(_ModularAutoGen)' == '' or '@(_ModularSource)' == '' or '@(_ModularTools)' == ''"
           Text="ModularTools packaging refuses an incomplete source tree." />
    <ElixrValidatePaths Paths="@(_ModularAutoGen);@(_ModularSource);@(_ModularTools)" AllowedRoots="$(MSBuildProjectDirectory)" />
    <ElixrValidatePaths Paths="@(_ModularAutoGen->'$(_ModularPackage)AutoGen\%(RecursiveDir)%(Filename)%(Extension)');@(_ModularSource->'$(_ModularPackage)ModularTools\%(RecursiveDir)%(Filename)%(Extension)');@(_ModularTools->'$(_ModularPackage)Tools\%(RecursiveDir)%(Filename)%(Extension)')" AllowedRoots="$(ElixrRepositoryRoot)bin" />
    <Copy SourceFiles="@(_ModularAutoGen)" DestinationFiles="@(_ModularAutoGen->'$(_ModularPackage)AutoGen\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ModularSource)" DestinationFiles="@(_ModularSource->'$(_ModularPackage)ModularTools\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ModularTools)" DestinationFiles="@(_ModularTools->'$(_ModularPackage)Tools\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

