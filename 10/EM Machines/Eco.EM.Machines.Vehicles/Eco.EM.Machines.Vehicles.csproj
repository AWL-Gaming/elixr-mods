<Project Sdk="Microsoft.NET.Sdk">


	<PropertyGroup>
		
		<RootNamespace>Eco.EM.Machines.Vehicles</RootNamespace>
		<Company>Elixr Solutions</Company>
		<Authors>Elixr Mods</Authors>
		<Product>EM Vehicles</Product>
		<Version>3.5.0</Version>
		<Copyright>Elixr Solutions 2020</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://elixrmods.com/</PackageProjectUrl>
		<PackageIcon></PackageIcon>
		<RepositoryUrl>https://git.elixr-solutions.com/elixrmods/elixr-mods</RepositoryUrl>
		<RepositoryType>Private GitLab</RepositoryType>
		<NeutralLanguage>en</NeutralLanguage>
		<AssemblyName>Eco.EM.Machines.Vehicles</AssemblyName>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>ElixrMods.Machines.Vehicles</PackageId>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<RunPostBuildEvent>OnOutputUpdated</RunPostBuildEvent>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<OutputPath>..\..\..\bin\10.0\EM Machines</OutputPath>
	</PropertyGroup>

	<PropertyGroup>
    <ElixrCleanOutput>true</ElixrCleanOutput>
    <ElixrStripArtistry>true</ElixrStripArtistry>
  </PropertyGroup>
  <Import Project="..\..\..\build\ElixrOutput.targets" />

	<ItemGroup>
	  <Compile Remove="Base\RailBlocks.cs" />
	  <Compile Remove="ModularTruck\BoxTruckItem.cs" />
	  <Compile Remove="ModularTruck\GarbageTruckItem.cs" />
	  <Compile Remove="ModularTruck\MiningTruckItem.cs" />
	  <Compile Remove="ModularTruck\ModularTruck.cs" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="FodyWeavers.xml" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="Base\RailBlocks.cs" />
	  <None Include="ModularTruck\BoxTruckItem.cs" />
	  <None Include="ModularTruck\GarbageTruckItem.cs" />
	  <None Include="ModularTruck\MiningTruckItem.cs" />
	  <None Include="ModularTruck\ModularTruck.cs" />
	</ItemGroup>
</Project>
