<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    
    <RootNamespace>Eco.EM.Food.Hunting</RootNamespace>
    <Company>Elixr Solutions</Company>
    <Authors>Elixr Mods</Authors>
    <Product>EM Hunting</Product>
    <Version>3.4.0</Version>
    <Copyright>Elixr Solutions 2020</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://elixrmods.com/</PackageProjectUrl>
    <PackageIcon></PackageIcon>
    <RepositoryUrl>https://git.elixr-solutions.com/elixrmods/elixr-mods</RepositoryUrl>
    <RepositoryType>Private GitLab</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyName>Eco.EM.Food.Hunting</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>ElixrMods.Food.Hunting</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\..\bin\10.0\EM Food</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <ElixrCleanOutput>true</ElixrCleanOutput>
    <ElixrStripArtistry>true</ElixrStripArtistry>
  </PropertyGroup>
  <Import Project="..\..\..\build\ElixrOutput.targets" />

  <ItemGroup>
    <Compile Remove="Objects\DeerTrap.cs" />
    <Compile Remove="Objects\FoxTrap.cs" />
    <Compile Remove="Objects\FreshWaterFishingNet.cs" />
    <Compile Remove="Objects\HareTrap.cs" />
    <Compile Remove="Objects\SaltWaterFishingNet.cs" />
    <Compile Remove="Weapons\Bullet.cs" />
    <Compile Remove="Weapons\HuntingRifle.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Items\" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="Objects\DeerTrap.cs" />
    <None Include="Objects\FoxTrap.cs" />
    <None Include="Objects\FreshWaterFishingNet.cs" />
    <None Include="Objects\HareTrap.cs" />
    <None Include="Objects\SaltWaterFishingNet.cs" />
    <None Include="Weapons\Bullet.cs" />
    <None Include="Weapons\HuntingRifle.cs" />
  </ItemGroup>
  <ItemGroup>
    
  </ItemGroup>

</Project>
