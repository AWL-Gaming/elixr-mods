<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	
	<RootNamespace>Eco.EM.Games.BoardGames</RootNamespace>
	<Authors>Elixr Mods</Authors>
	<Company>Elixr Solutions</Company>
	<Product>EM BoardGames</Product>
	<Version>3.4.0</Version>
	<Copyright>Elixr Solutions 2020</Copyright>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageProjectUrl>https://elixrmods.com/</PackageProjectUrl>
	<PackageIcon></PackageIcon>
	<RepositoryUrl>https://git.elixr-solutions.com/elixrmods/elixr-mods</RepositoryUrl>
	<RepositoryType>Private GitLab</RepositoryType>
	<NeutralLanguage>en</NeutralLanguage>
	<AssemblyName>Eco.EM.Games.BoardGames</AssemblyName>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	<PackageId>ElixrMods.Games.BoardGames</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	<OutputPath>..\..\..\bin\10.0\EM Games</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <ElixrCleanOutput>true</ElixrCleanOutput>
    <ElixrStripArtistry>true</ElixrStripArtistry>
  </PropertyGroup>
  <Import Project="..\..\..\build\ElixrOutput.targets" />

  <ItemGroup>
    <Compile Remove="Objects\Battleship\Battleship.cs" />
    <Compile Remove="Objects\Battleship\Carrier.cs" />
    <Compile Remove="Objects\Battleship\Destroyer.cs" />
    <Compile Remove="Objects\Battleship\PatrolBoat.cs" />
    <Compile Remove="Objects\Battleship\PinHit.cs" />
    <Compile Remove="Objects\Battleship\PinMiss.cs" />
    <Compile Remove="Objects\Battleship\Submarine.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Objects\Battleship\Battleship.cs" />
    <None Include="Objects\Battleship\Carrier.cs" />
    <None Include="Objects\Battleship\Destroyer.cs" />
    <None Include="Objects\Battleship\PatrolBoat.cs" />
    <None Include="Objects\Battleship\PinHit.cs" />
    <None Include="Objects\Battleship\PinMiss.cs" />
    <None Include="Objects\Battleship\Submarine.cs" />
  </ItemGroup>
</Project>
